# =============================================================================
# EduVision AI — Environment Configuration Example (Root)
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=EduVision AI
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE-ME-TO-A-RANDOM-SECRET-KEY-32CHARS
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://eduvision:eduvision@localhost:5432/eduvision
DATABASE_SYNC_URL=postgresql://eduvision:eduvision@localhost:5432/eduvision
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300
REDIS_SOCKET_TIMEOUT=10
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY=0.5

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=false
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_DLQ_ENABLED=false
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY=60

# ── Storage (S3-compatible, MinIO for local) ─────────────────────────────────
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_NAME=eduvision-content
S3_PUBLIC_BUCKET_NAME=eduvision-public
S3_USE_SSL=false
LOCAL_STORAGE_PATH=./storage-data

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_OUTPUT=console
LOG_MASK_SENSITIVE=true

# ── AI / LLM Providers ────────────────────────────────────────────────────────
AI_PROVIDER=local
# AI_API_KEY=your-gemini-or-openai-api-key-here
# AI_MODEL=gemini-2.5-flash

# ── Security & Authentication ────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_AUDIENCE=eduvision-api
JWT_ISSUER=eduvision-auth
PASSWORD_HASH_ALGORITHM=argon2
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
VERIFICATION_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_HOURS=1
EMAIL_VERIFICATION_REQUIRED=false

# ── Google OAuth (Sign in with Google) ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── CSRF & Cookies ───────────────────────────────────────────────────────────
CSRF_ENABLED=true
CSRF_SECRET=CHANGE-ME-CSRF-SECRET
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

# ── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=104857600
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.pptx,.docx,.txt,.jpg,.png,.mp4,.webm
UPLOAD_CHUNK_SIZE=5242880
