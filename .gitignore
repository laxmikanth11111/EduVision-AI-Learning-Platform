# =============================================================================
# EduVision AI — Comprehensive .gitignore
# =============================================================================

# ── 1. Environment & Secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.env
*.env.local
*.env.production
*.env.development
*.env.staging
*.env.test

# ── 2. Databases & Database Storage ──────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.sql.gz
dump.rdb
/postgres_data/
**/postgres_data/
/pgdata/
**/pgdata/
/redis_data/
**/redis_data/
/minio_data/
**/minio_data/
/database/
/data/
/backups/
**/backups/

# ── 3. Docker Local Storage & Volumes ────────────────────────────────────────
/volumes/
**/volumes/
/docker-data/
**/docker-data/
/docker-volumes/
**/docker-volumes/
/upload_data/
**/upload_data/
.docker/
**/.docker/

# ── 4. User / Personal Data & File Uploads ────────────────────────────────────
uploads/
**/uploads/
/storage/
local_storage/
**/local_storage/
storage-data/
**/storage-data/
user_data/
**/user_data/
/media/
**/media/
/generated/
**/generated/
/output/
**/output/
/outputs/
**/outputs/

# ── 5. Generated / Temporary / Log Files ──────────────────────────────────────
logs/
**/logs/
*.log
**/*.log
tmp/
**/tmp/
temp/
**/temp/
cache/
**/cache/
.cache/
**/.cache/
coverage/
**/coverage/
htmlcov/
**/htmlcov/
.coverage
.coverage.*
celerybeat-schedule
celerybeat-schedule.*
fail_list.txt
full_results.txt
demo_output.txt

# ── 6. Python Local Environment & Caches ──────────────────────────────────────
.venv/
**/.venv/
.venv*/
**/venv*/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/
dist/
build/
.eggs/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
*.egg-info/
**/*.egg-info/

# ── 7. JavaScript / Node / Next.js ───────────────────────────────────────────
node_modules/
**/node_modules/
.next/
**/.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 8. IDE & Operating System Files ──────────────────────────────────────────
.vscode/
**/.vscode/
.idea/
**/.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
**/desktop.ini
*.swp
*.swo
*~
MEMORY.md
**/MEMORY.md

# ── 9. AI / ML / Vector Databases / Large Models ─────────────────────────────
/models/
model_cache/
**/model_cache/
/embeddings/
vector_store/
**/vector_store/
chroma/
**/chroma/
faiss_index/
**/faiss_index/
checkpoints/
**/checkpoints/

# ── 10. Certificates, Keys & Private Credentials ──────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ecdsa*
id_ed25519*

# ── 11. Backend Ad-hoc / Scratch Test Scripts ────────────────────────────────
test_check.py
test_debug.py
test_direct.py
test_sanity.py
**/test_check.py
**/test_debug.py
**/test_direct.py
**/test_sanity.py

# ── 12. App Code Overrides (Keep packages, ignore caches unconditionally) ───
!backend/app/database/
!backend/app/models/
!backend/app/storage/
!backend/app/ai/embeddings/

# Caches and bytecode MUST be ignored everywhere without exception
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
